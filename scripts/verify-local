#!/bin/sh
# Local P0 verification (R0): offline core passes with reliable failure exits.
# Each step captures a log and checks the real exit status; no `cmd | tail`
# pipelines that would mask a runner failure with tail's status.
# Usage: sh scripts/verify-local [--live]
#   default: offline gates only; live provider spike is skipped honestly.
#   --live:  fail unless a key is configured AND live calls actually ran
#            (live spike runner lands in R3; until then --live fails loudly).
set -u
cd "$(dirname "$0")/.."
# Guard against self-recursion: the propagation tests below invoke this very
# script, and this script runs the test suites that contain them. Nested
# invocations skip the self-hosting tests and terminate.
export FRAMEBOUND_VERIFY_ACTIVE=1

LOGS="$(mktemp -d "${TMPDIR:-/tmp}/fb-verify-logs-XXXXXX")"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/fb-verify-work-XXXXXX")"
cleanup() { rm -rf "$LOGS" "$WORK"; }
trap cleanup EXIT INT TERM

step() {
  name="$1"; shift
  log="$LOGS/$name.log"
  echo "== $name =="
  "$@" >"$log" 2>&1
  st=$?
  tail -n 8 "$log"
  if [ "$st" -ne 0 ]; then
    echo "FAIL $name (exit $st; full log: $log; work kept at: $WORK)"
    trap - EXIT INT TERM
    echo "logs kept at $LOGS, work kept at $WORK for inspection"
    exit "$st"
  fi
  echo "ok: $name"
}

LIVE=0
if [ "${1:-}" = "--live" ]; then LIVE=1; fi

step v1-unittest python -m unittest discover -s tests
step v2-pytest python -m pytest tests/ -q

# Offline neutrality: offline gates must not touch providers even when keys exist.
# Remember real credentials for the --live check, then ensure *some* key value
# is present so a code path that "helpfully" goes live when keys exist is caught.
HAD_KEY=0
if [ -n "${MODEL_API_KEY:-}" ] || [ -n "${META_API_KEY:-}" ]; then HAD_KEY=1; fi
: "${MODEL_API_KEY:=verify-local-bogus-key}"
: "${META_API_KEY:=verify-local-bogus-key}"
export MODEL_API_KEY META_API_KEY
step demo-v2-offline python -m framebound demo --profile v2 --offline --out "$WORK/verify-v2"
step demo-wp6-offline python -m framebound demo --profile wp6 --offline --out "$WORK/verify-wp6"
step verify-stored python -m framebound verify --project "$WORK/verify-wp6/project"

step export-roundtrip python - "$WORK" << 'PYEOF'
import json, sys
from pathlib import Path
from framebound.v2.devseed import build_minimal_project
from framebound.v2.exports import build_snapshot, validate_snapshot
work = Path(sys.argv[1])
td = work / "devseed-proj"
info = build_minimal_project(td)
out = work / "snap"
man = build_snapshot(str(td), "verify", ["clip-devseed-bad"], str(out), {})
moved = work / "moved"
out.rename(moved)
rep = validate_snapshot(str(moved))
assert rep["ok"], rep["issues"]
print("snapshot OK:", json.dumps(rep["counts"]))
PYEOF

if [ -f web/package.json ] && command -v npm >/dev/null 2>&1; then
  step web-typecheck npm --prefix web run typecheck
  step api-types-fresh python scripts/gen_api_types.py --check
  step web-unit npm --prefix web run test:unit
  step web-build npm --prefix web run build
else
  echo "SKIP web typecheck/build: npm or web/package.json unavailable (recorded, not a pass)"
fi

# R6 browser/process-restart journey: real API + real browser, separate OS
# processes, disposable data. No screenshots-count criteria; every check in
# web/e2e/journey.mjs is a throwing assertion on served pixels, stored
# geometry, persisted bytes, or exact events.
E2E_PORT="${E2E_PORT:-8766}"
if [ -f web/package.json ] && command -v npm >/dev/null 2>&1 && [ -d web/node_modules ]; then
  step browser-journey env E2E_PORT="$E2E_PORT" E2E_WORK="$WORK/e2e" E2E_SHOTS="$WORK/e2e-shots" node web/e2e/journey.mjs
else
  echo "SKIP browser/process-restart journey: web toolchain unavailable (recorded, not a pass)"
fi

if [ "$LIVE" -eq 1 ]; then
  if [ "$HAD_KEY" -eq 0 ]; then
    echo "FAIL: --live requires a real MODEL_API_KEY/META_API_KEY (none configured)"
    exit 2
  fi
  # The recorded four-capability workflow is the live gate: it spends through
  # the real controller only with an explicit spend ceiling, otherwise it
  # stays pending with the exact executable command (no uncontrolled spend).
  if [ -z "${FRAMEBOUND_SPEND_CEILING:-}" ]; then
    echo "PENDING live gate: authorized credential present but no explicit spend ceiling."
    echo "Run with FRAMEBOUND_SPEND_CEILING set (e.g. FRAMEBOUND_SPEND_CEILING=usd-5) to execute:"
    echo '  python -m framebound recorded-run --project <proj> --contract <id> --slot 0 \'
    echo '    --baseline <rev> --new-id <rev> --idempotency-key live-spike-1 --out <bundle.json>' 
    exit 3
  fi
  step recorded-live python - "$WORK" << 'PYEOF2'
import json, sys
from pathlib import Path
from framebound.v2.devseed import build_minimal_project
from framebound.v2 import recorded_run as RR
from framebound.v2.services.errors import InvalidInput
work = Path(sys.argv[1])
td = work / "live-proj"
info = build_minimal_project(td)
try:
    prepared = RR.prepare(str(td), "contract-devseed-01", 0)
except InvalidInput as e:
    print("PENDING live gate: the recorded runner needs one genuine human "
          "reference approval first (real external input, never synthesized).")
    print(f"  reason: {e}")
    print("  next: serve this project on the review desk, approve the char-01 "
          "references, then re-run with the same idempotency key "
          "(live-spike-1) to resume without respending.")
    sys.exit(3)
out = work / "live-bundle.json"
bundle = RR.run_recorded(str(td), str(out), contract_id="contract-devseed-01",
                         slot=0, baseline_revision_id="clip-devseed-bad",
                         new_revision_id="rev-live-spike",
                         offline=False, idempotency_key="live-spike-1")
caps = {c["capability"]: c["status"] for c in bundle.get("capabilities", [])}
print(json.dumps({"status": bundle["status"], "origin": bundle["origin"],
                  "capabilities": caps}, indent=2))
assert bundle["origin"] == "live", bundle
assert bundle["status"] == "recorded", bundle
assert set(caps) == {"spark-critique", "image-generation", "image-edit",
                     "sam-segmentation"}, caps
assert all(s == "recorded" for s in caps.values()), caps
PYEOF2
else
  echo "SKIP live provider spike: offline mode (recorded, not a pass)"
fi

echo "ALL LOCAL CHECKS PASSED"
