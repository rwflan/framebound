{
  "additionalProperties": false,
  "description": "Durable orchestrator run: budget + halt state survive restarts.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "status": {
      "default": "running",
      "maxLength": 64,
      "title": "Status",
      "type": "string"
    },
    "job_ids": {
      "items": {
        "type": "string"
      },
      "title": "Job Ids",
      "type": "array"
    },
    "attempts_used": {
      "default": 0,
      "minimum": 0,
      "title": "Attempts Used",
      "type": "integer"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "halt_reason": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Halt Reason"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "kind": {
      "default": "provider",
      "enum": [
        "provider",
        "animation"
      ],
      "title": "Kind",
      "type": "string"
    },
    "baseline_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Revision Id"
    },
    "current_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Revision Id"
    },
    "compiled_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compiled Plan Id"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Sha256"
    },
    "provider_settings": {
      "additionalProperties": true,
      "title": "Provider Settings",
      "type": "object"
    },
    "provider_offline": {
      "default": true,
      "title": "Provider Offline",
      "type": "boolean"
    },
    "operation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Operation Ids",
      "type": "array"
    },
    "local_attempts_used": {
      "default": 0,
      "minimum": 0,
      "title": "Local Attempts Used",
      "type": "integer"
    },
    "compute_steps_used": {
      "default": 0,
      "minimum": 0,
      "title": "Compute Steps Used",
      "type": "integer"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    }
  },
  "required": [
    "id"
  ],
  "title": "Run",
  "type": "object"
}