{
  "$defs": {
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "needs_attention"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Durable generation job. New fields default so pre-R3 rows still load.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "queued"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "provider": {
      "default": "image",
      "maxLength": 64,
      "title": "Provider",
      "type": "string"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    },
    "attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "budget_reserved": {
      "default": "unbounded-note",
      "maxLength": 200,
      "title": "Budget Reserved",
      "type": "string"
    },
    "cost_estimate": {
      "default": "unknown",
      "maxLength": 200,
      "title": "Cost Estimate",
      "type": "string"
    },
    "cost_actual": {
      "default": "unknown",
      "maxLength": 200,
      "title": "Cost Actual",
      "type": "string"
    },
    "no_progress_signatures": {
      "items": {
        "type": "string"
      },
      "title": "No Progress Signatures",
      "type": "array"
    },
    "request_brief": {
      "additionalProperties": true,
      "title": "Request Brief",
      "type": "object"
    },
    "provider_settings": {
      "additionalProperties": true,
      "title": "Provider Settings",
      "type": "object"
    },
    "origin": {
      "default": "unknown",
      "maxLength": 64,
      "title": "Origin",
      "type": "string"
    },
    "fencing_token_sha256": {
      "default": "",
      "title": "Fencing Token Sha256",
      "type": "string"
    },
    "dispatch_count": {
      "default": 0,
      "minimum": 0,
      "title": "Dispatch Count",
      "type": "integer"
    },
    "dispatch_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dispatch Run Id"
    },
    "settlement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Settlement"
    },
    "dispatch_inflight": {
      "default": false,
      "title": "Dispatch Inflight",
      "type": "boolean"
    },
    "wire_started": {
      "default": false,
      "title": "Wire Started",
      "type": "boolean"
    },
    "dispatch_token_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dispatch Token Sha256"
    },
    "frozen_request": {
      "additionalProperties": true,
      "title": "Frozen Request",
      "type": "object"
    },
    "frozen_request_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen Request Sha256"
    },
    "reserved_microusd": {
      "default": 0,
      "minimum": 0,
      "title": "Reserved Microusd",
      "type": "integer"
    },
    "reserved_cost": {
      "default": "unbounded-note",
      "maxLength": 200,
      "title": "Reserved Cost",
      "type": "string"
    },
    "request_artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Artifact"
    },
    "response_artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Artifact"
    },
    "output_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Output Asset Ids",
      "type": "array"
    },
    "output_annotation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Output Annotation Ids",
      "type": "array"
    },
    "provider_response_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Response Id"
    },
    "provider_outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Outcome"
    },
    "reconciliation_required": {
      "default": false,
      "title": "Reconciliation Required",
      "type": "boolean"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "offline": {
      "default": false,
      "title": "Offline",
      "type": "boolean"
    },
    "lease_holder": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Holder"
    },
    "lease_expires": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "idempotency_key",
    "payload_sha256"
  ],
  "title": "Job",
  "type": "object"
}